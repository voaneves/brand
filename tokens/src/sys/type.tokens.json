          "group": "Display",
          "tracking": "-0.03em",
          "opsz": 144,
          "fluid": "clamp(4rem,10vw,9rem)",
          "italic": true,
          "uppercase": false,
          "sample": "FALECOMIGO!"
        }
      }
    },
