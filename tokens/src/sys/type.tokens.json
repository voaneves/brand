{
  "font": {
    "$description": "Semantic font roles. CSS: --vn-font-display, --vn-font-text, --vn-font-mono.",
    "display": {
      "$type": "fontFamily",
      "$value": "{ref.font.family.fraunces}",
      "$description": "Display and editorial headings (h1-h3, numeral)."
    },
    "text": {
      "$type": "fontFamily",
      "$value": "{ref.font.family.schibsted}",
      "$description": "Body and UI text."
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "{ref.font.family.jetbrains}",
      "$description": "Labels, tags, prices, code, wordmark."
    },
    "opsz-hero": {
      "$type": "number",
      "$value": 144,
      "$description": "Fraunces optical size pinned on the hero via font-variation-settings. Other sizes use font-optical-sizing: auto."
    }
  },
  "type": {
    "$description": "Type ladder (sqrt2 from 18px body) as typography composites. lineHeight is unitless. letterSpacing is px at the reference size; the em source value is in $extensions.vn.tracking and is what the CSS build emits. $extensions.vn: group, tracking, opsz, fluid clamp(), italic, uppercase, sample.",
    "hero": {
      "$type": "typography",
      "$description": "Display style, 208px.",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": {
          "value": 208,
          "unit": "px"
        },
        "lineHeight": 0.88,
        "fontWeight": "{ref.font.weight.black}",
        "letterSpacing": {
          "value": -6.24,
          "unit": "px"
        }
      },
      "$extensions": {
        "vn": {
          "group": "Display",
          "tracking": "-0.03em",
          "opsz": 144,
          "fluid": "clamp(5.5rem,13vw,13rem)",
          "italic": true,
          "uppercase": false,
          "sample": "VICTOR NEVES"
        }
      }
    },
    "display": {
      "$type": "typography",
      "$description": "Display style, 144px.",
