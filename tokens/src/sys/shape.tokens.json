    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 14,
        "unit": "px"
      },
      "$description": "Inputs."
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      },
      "$description": "Large controls."
    },
    "xl": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      },
      "$description": "Cards."
    },
    "2xl": {
      "$type": "dimension",
      "$value": {
        "value": 28,
        "unit": "px"
      },
