{
  "status-pill": {
    "$description": "Availability pill: dot plus mono label.",
    "dot": {
      "size": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "px"
        },
        "$description": "Dot diameter."
      },
      "bg": {
        "$type": "color",
        "$value": "{color.signal}",
        "$description": "Dot color."
      }
    },
    "pulse": {
      "count": {
        "$type": "number",
        "$value": 3,
        "$description": "Pulse iterations on load, then rest (WCAG 2.2.2)."
      },
      "duration": {
        "$type": "duration",
        "$value": {
          "value": 1600,
          "unit": "ms"
        },
        "$description": "One pulse cycle."
      },
      "spread": {
        "$type": "dimension",
        "$value": {
          "value": 10,
          "unit": "px"
        },
        "$description": "Ring spread at end of pulse."
      }
    }
  }
}
