{
  "name": "@voaneves/brand",
  "version": "1.0.0",
  "private": false,
  "description": "Victor Neves brand identity and design system: tokens, CSS, JS, fonts, icons and logo.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voaneves/brand.git"
  },
  "homepage": "https://github.com/voaneves/brand#readme",
  "bugs": {
    "url": "https://github.com/voaneves/brand/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "fonts/*.woff2",
    "fonts/OFL-*.txt",
    "astro",
    "LICENSES.md"
  ],
  "exports": {
    "./css/tokens.css": "./dist/css/tokens.css",
    "./css/fonts.css": "./dist/css/fonts.css",
    "./css/base.css": "./dist/css/base.css",
    "./css/components.css": "./dist/css/components.css",
    "./css/all.css": "./dist/css/all.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.json": "./dist/tokens.json",
    "./js/*": "./dist/js/*.js",
    "./fonts/*": "./fonts/*",
    "./icons/*": "./dist/icons/*",
    "./logo/*": "./dist/logo/*",
    "./app-icons/*": "./dist/app-icons/*",
    "./astro/*": "./astro/*",
    "./credit": "./dist/credit/credit.html",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "astro": ">=7"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run build:tokens && npm run build:fonts && npm run build:icons && npm run build:css && npm run build:board",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:css": "node scripts/build-css.mjs",
    "build:icons": "node scripts/normalize-icons.mjs && node scripts/build-icons.mjs",
    "build:fonts": "node scripts/build-fonts.mjs",
    "build:board": "node scripts/build-board.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "test": "node --test tests/*.test.js && npm run check:exports"
  },
  "devDependencies": {
    "style-dictionary": "^5.8.0",
    "subset-font": "^2.9.0"
  }
}
