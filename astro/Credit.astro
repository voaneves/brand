---
export interface Props {
  variant?: 'inline' | 'stack';
  lang?: 'pt-BR' | 'en';
  utmSource?: string;
  class?: string;
}

const {
  variant = 'inline',
  lang = 'pt-BR',
  utmSource = 'client',
  class: className = '',
} = Astro.props;

const prefix = lang === 'en' ? 'Made by' : 'Feito por';
const href = `https://voaneves.com/?utm_source=${encodeURIComponent(utmSource)}&utm_medium=credit`;
---

<a
  href={href}
  rel="noopener"
  class={`vn-credit ${variant === 'stack' ? 'vn-credit--stack' : ''} ${className}`.trim()}
  style={variant === 'stack' ? 'flex-direction: column; align-items: flex-start;' : undefined}
>
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 512 512" aria-hidden="true">
    <path
      fill="currentColor"
      fill-rule="evenodd"
      d="M0 256a256 256 0 1 0 512 0a256 256 0 1 0-512 0ZM142 148L214 148L250 244L286 148L358 148L277 364L223 364Z"
    />
    <circle cx="340" cy="337" r="27" fill="#f50000" />
  </svg>
  <span>{prefix} <strong>voaneves</strong></span>
</a>
